# استفاده روی VPS:
#   cp .env.production.example .env.production
#   (رمز واقعی رو داخل .env.production بذار، این فایل فقط نمونه‌ست)
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# رمز دیتابیس Postgres — باید با DATABASE_URL داخل apps/api/.env.production هم‌خوان باشه
POSTGRES_PASSWORD="یک-رمز-قوی-اینجا"

# P1-E3-F1-T1 — رمز Redis — یک رمز قوی و متفاوت از POSTGRES_PASSWORD (openssl rand -hex 24)
REDIS_PASSWORD="یک-رمز-قوی-متفاوت-اینجا"

# P0-E1-F1-T1 -- the hostname Caddy requests a TLS certificate for. Must be a
# real domain (or subdomain) that resolves to this VPS's public IP -- Let's
# Encrypt cannot issue a certificate for a bare IP address. If you don't own
# a domain yet, https://nip.io gives you one for free: replace the dots in
# your VPS's IP with dashes and append ".nip.io", e.g. an IP of 203.0.113.10
# becomes "203-0-113-10.nip.io" -- resolves automatically, no DNS setup
# needed, good enough for a real trusted certificate today.
DOMAIN="your-domain-or-ip-dashed.nip.io"
