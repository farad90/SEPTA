# استفاده روی VPS:
#   cp .env.production.example .env.production
#   (رمز واقعی رو داخل .env.production بذار، این فایل فقط نمونه‌ست)
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# رمز دیتابیس Postgres — باید با DATABASE_URL داخل apps/api/.env.production هم‌خوان باشه
POSTGRES_PASSWORD="یک-رمز-قوی-اینجا"
