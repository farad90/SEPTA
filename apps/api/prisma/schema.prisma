model FreightRfqCounter {
  year       Int @id
  lastSerial Int @default(0) @map("last_serial")

  @@map("freight_rfq_counters")
}

model ShipmentCounter {
  year       Int @id
  lastSerial Int @default(0) @map("last_serial")

  @@map("shipment_counters")
}

// ============================================================
// فاز ۱۲ — دریافت کالا در انبار (تکمیل دامنه ۶) + تحویل و تسویه (دامنه ۷)
// ============================================================

model WarehouseReceipt {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId            String    @map("shipment_id") @db.Uuid
  receiptNumber         String    @unique @map("receipt_number") @db.VarChar(50)
  arrivalDate           DateTime  @map("arrival_date") @db.Date
  destinationWarehouse  String?   @map("destination_warehouse") @db.VarChar(200)
  packagingCondition    String?   @map("packaging_condition") @db.VarChar(20)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  shipment Shipment               @relation(fields: [shipmentId], references: [id])
  items    WarehouseReceiptItem[]

  @@map("warehouse_receipts")
}

model WarehouseReceiptItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseReceiptId  String  @map("warehouse_receipt_id") @db.Uuid
  inquiryItemId       String  @map("inquiry_item_id") @db.Uuid
  receivedQuantity    Decimal @map("received_quantity") @db.Decimal(18, 4)

  warehouseReceipt WarehouseReceipt        @relation(fields: [warehouseReceiptId], references: [id], onDelete: Cascade)
  inquiryItem      InquiryItem             @relation(fields: [inquiryItemId], references: [id])
  photos           WarehouseReceiptPhoto[]

  @@unique([warehouseReceiptId, inquiryItemId])
  @@map("warehouse_receipt_items")
}

model WarehouseReceiptPhoto {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseReceiptItemId String   @map("warehouse_receipt_item_id") @db.Uuid
  photoUrl               String   @map("photo_url")
  uploadedAt              DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  warehouseReceiptItem WarehouseReceiptItem @relation(fields: [warehouseReceiptItemId], references: [id], onDelete: Cascade)

  @@map("warehouse_receipt_photos")
}

model Delivery {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                   String    @map("order_id") @db.Uuid
  actualDeliveryDate        DateTime  @map("actual_delivery_date") @db.Date
  deliveryMethod            String?   @map("delivery_method") @db.VarChar(20)
  recipientName             String?   @map("recipient_name") @db.VarChar(200)
  deliveryReceiptFileUrl    String?   @map("delivery_receipt_file_url")
  customerAcceptanceDate    DateTime? @map("customer_acceptance_date") @db.Date
  customerAcceptanceStatus  String    @default("pending") @map("customer_acceptance_status") @db.VarChar(30)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

model Invoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber    String    @unique @map("invoice_number") @db.VarChar(50)
  orderId          String    @map("order_id") @db.Uuid
  finalAmountIrr   Decimal   @map("final_amount_irr") @db.Decimal(18, 2)
  issueDate        DateTime  @map("issue_date") @db.Date
  paymentDeadline  DateTime? @map("payment_deadline") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order       Order               @relation(fields: [orderId], references: [id])
  items       InvoiceItem[]
  collections InvoiceCollection[]

  @@map("invoices")
}

model InvoiceItem {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId                String   @map("invoice_id") @db.Uuid
  description              String   @db.VarChar(200)
  sourceCustomerPaymentId  String?  @map("source_customer_payment_id") @db.Uuid
  amountCurrency           Decimal  @map("amount_currency") @db.Decimal(18, 4)
  currencyCode             String   @map("currency_code") @db.VarChar(3)
  exchangeRateDate         DateTime @map("exchange_rate_date") @db.Date
  exchangeRateValue        Decimal  @map("exchange_rate_value") @db.Decimal(18, 4)
  amountIrr                Decimal  @map("amount_irr") @db.Decimal(18, 2)

  invoice              Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceCustomerPayment CustomerPayment? @relation(fields: [sourceCustomerPaymentId], references: [id])
  currency             Currency         @relation(fields: [currencyCode], references: [currencyCode])

  @@map("invoice_items")
}

model InvoiceCollection {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId               String    @map("invoice_id") @db.Uuid
  dueDate                 DateTime? @map("due_date") @db.Date
  totalAmount             Decimal   @map("total_amount") @db.Decimal(18, 4)
  actualReceiptDate       DateTime? @map("actual_receipt_date") @db.Date
  paymentDocumentFileUrl  String?   @map("payment_document_file_url")
  paymentMethod           String?   @map("payment_method") @db.VarChar(20)
  settlementStatus        String    @default("pending") @map("settlement_status") @db.VarChar(20)
  followUpNotes           String?   @map("follow_up_notes")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_collections")
}

// ============================================================
// فاز ۱۳ — مکاتبات و بایگانی اسناد (دامنه ۸)
// ============================================================

model LetterCounter {
  year        Int    @map("year")
  ourEntityId String @map("our_entity_id") @db.Uuid
  lastSerial  Int    @default(0) @map("last_serial")

  ourEntity OurEntity @relation(fields: [ourEntityId], references: [id])

  @@id([year, ourEntityId])
  @@map("letter_counters")
}

// فاز ۴۰-ب — شمارنده اتمیک شماره پیشنهاد مالی/فنی بر مبنای شرکت گروه صادرکننده.
// ⚠️ Deprecated از فاز ۵۰-الف — جایگزین شد با ProposalGlobalCounter (شمارنده‌ی سراسری سالانه،
// بدون حرف). طبق قاعده‌ی Rollback-پذیری پروژه حذف نشد؛ فقط دیگه خونده/نوشته نمی‌شه.
model ProposalCounter {
  year        Int    @map("year")
  ourEntityId String @map("our_entity_id") @db.Uuid
  lastSerial  Int    @default(0) @map("last_serial")

  ourEntity OurEntity @relation(fields: [ourEntityId], references: [id])

  @@id([year, ourEntityId])
  @@map("proposal_counters")
}

// فاز ۵۰-الف — بازخورد کاربر: شماره پیشنهاد مالی/فنی باید بر مبنای سال میلادی باشه و هیچ
// حرفی داخلش نباشه؛ جایگزین ProposalCounter (بالا) با شمارنده‌ی سراسری، هم‌الگوی InquiryCounter/RfqCounter
// ⚠️ Deprecated از فاز ۵۱ — جایگزین شد با ProposalClientCounter (زیر). طبق قاعده‌ی
// Rollback-پذیری پروژه حذف نشد؛ فقط دیگه خونده/نوشته نمی‌شه.
model ProposalGlobalCounter {
  year       Int @id
  lastSerial Int @default(0) @map("last_serial")

  @@map("proposal_global_counters")
}

// فاز ۵۱ — بازخورد کاربر: شماره پیشنهاد (و بارکد متناظرش) باید شامل سال + کد اختصاری
// شرکت مشتری (نه شرکت گروه ما) + سریال باشه؛ جایگزین ProposalGlobalCounter
model ProposalClientCounter {
  year           Int    @map("year")
  buyerPartnerId String @map("buyer_partner_id") @db.Uuid
  lastSerial     Int    @default(0) @map("last_serial")

  buyerPartner BusinessPartner @relation(fields: [buyerPartnerId], references: [id])

  @@id([year, buyerPartnerId])
  @@map("proposal_client_counters")
}

model Letter {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letterNumber         String?   @unique @map("letter_number") @db.VarChar(50)
  type                 String    @db.VarChar(20)
  letterDate           DateTime  @map("letter_date") @db.Date
  subject              String    @db.VarChar(500)
  senderOurEntityId    String?   @map("sender_our_entity_id") @db.Uuid
  senderPartnerId      String?   @map("sender_partner_id") @db.Uuid
  senderContactId      String?   @map("sender_contact_id") @db.Uuid
  receiverOurEntityId  String?   @map("receiver_our_entity_id") @db.Uuid
  receiverPartnerId    String?   @map("receiver_partner_id") @db.Uuid
  receiverContactId    String?   @map("receiver_contact_id") @db.Uuid
  issuingEntityId      String    @map("issuing_entity_id") @db.Uuid
  department           String?   @db.VarChar(100)
  priority             String    @default("normal") @db.VarChar(20)
  status               String    @default("draft") @db.VarChar(20)
  relatedInquiryId     String?   @map("related_inquiry_id") @db.Uuid
  relatedShipmentId    String?   @map("related_shipment_id") @db.Uuid
  description          String?
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // فاز ۲۴ — بازطراحی جهت‌محور
  responsibleUserId        String?  @map("responsible_user_id") @db.Uuid
  senderReferenceNumber    String?  @map("sender_reference_number") @db.VarChar(100)
  internalFromDepartmentId String?  @map("internal_from_department_id") @db.Uuid
  internalToDepartmentId   String?  @map("internal_to_department_id") @db.Uuid

  senderOurEntity     OurEntity?       @relation("LetterSenderEntity", fields: [senderOurEntityId], references: [id])
  senderPartner       BusinessPartner? @relation("LetterSenderPartner", fields: [senderPartnerId], references: [id])
  senderContact       PartnerContact?  @relation("LetterSenderContact", fields: [senderContactId], references: [id])
  receiverOurEntity   OurEntity?       @relation("LetterReceiverEntity", fields: [receiverOurEntityId], references: [id])
  receiverPartner     BusinessPartner? @relation("LetterReceiverPartner", fields: [receiverPartnerId], references: [id])
  receiverContact     PartnerContact?  @relation("LetterReceiverContact", fields: [receiverContactId], references: [id])
  issuingEntity       OurEntity        @relation("LetterIssuingEntity", fields: [issuingEntityId], references: [id])
  relatedInquiry      Inquiry?         @relation("LetterRelatedInquiry", fields: [relatedInquiryId], references: [id])
  relatedShipment     Shipment?        @relation("LetterRelatedShipment", fields: [relatedShipmentId], references: [id])
  creator             User             @relation("LetterCreatedBy", fields: [createdBy], references: [id])
  responsibleUser     User?            @relation("LetterResponsibleUser", fields: [responsibleUserId], references: [id])
  internalFromDepartment Department?   @relation("LetterInternalFromDepartment", fields: [internalFromDepartmentId], references: [id])
  internalToDepartment   Department?   @relation("LetterInternalToDepartment", fields: [internalToDepartmentId], references: [id])
  documents           Document[]
