// ============================================================
// این فایل به‌صورت دستی نوشته شده، نه با `prisma db pull`.
//
// چرا: این محیط توسعه Docker/PostgreSQL در دسترس نداشت، پس امکان اجرای
// واقعی migration ها و introspect کردن دیتابیس زنده نبود. فقط مدل‌های
// استفاده‌شده در فاز ۱ (احراز هویت/RBAC) اینجا تعریف شدن، نه کل ۹ دامنه‌ی
// erp-schema.sql.
//
// ⚠️ اقدام لازم قبل از فاز ۲: بعد از اجرای migration 0001 و 0002 روی یک
// دیتابیس واقعی، دستور زیر رو اجرا کن تا این فایل با ساختار واقعی دیتابیس
// تطبیق داده بشه (و مدل‌های دامنه‌های بعدی هم اضافه بشن):
//   pnpm --filter api exec prisma db pull
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                    String    @map("full_name") @db.VarChar(200)
  fullNameEn                  String?   @map("full_name_en") @db.VarChar(200)
  // فاز ۵۱ — تا این فاز هیچ DTO ای این ستون رو نمی‌خوند/نمی‌نوشت؛ حالا به‌عنوان «شماره
  // داخلی» کاربر استفاده می‌شه (بدون نیاز به ستون جدید)
  phone                       String?   @db.VarChar(30)
  mobile                      String?   @db.VarChar(30)
  email                       String?   @unique @db.VarChar(200)
  profilePhotoUrl             String?   @map("profile_photo_url")
  birthDate                   DateTime? @map("birth_date") @db.Date
  nationalId                  String?   @map("national_id") @db.VarChar(20)
  birthCertificateNo          String?   @map("birth_certificate_no") @db.VarChar(20)
  address                     String?
  status                      String    @default("active") @db.VarChar(20)
  permissionGroupId           String?   @map("permission_group_id") @db.Uuid
  passwordHash                String    @map("password_hash")
  passwordResetToken          String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at") @db.Timestamptz
  requestedDepartment         String?   @map("requested_department") @db.VarChar(50)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  permissionGroup         PermissionGroup?  @relation("UserPermissionGroup", fields: [permissionGroupId], references: [id])
  createdPermissionGroups PermissionGroup[] @relation("PermissionGroupCreatedBy")
  refreshTokens           RefreshToken[]

  inquiriesAsSalesExpert Inquiry[]             @relation("InquirySalesExpert")
  inquiriesCreated       Inquiry[]             @relation("InquiryCreatedBy")
  inquiriesLocked        Inquiry[]             @relation("InquirySelectionLockedBy")
  discussionsAuthored    InquiryDiscussion[]   @relation("DiscussionAuthor")
  discussionsMentioned   InquiryDiscussion[]   @relation("DiscussionMentioned")
  uploadedItemDocuments  InquiryItemDocument[] @relation("ItemDocumentUploadedBy")
  uploadedInquiryDocuments InquiryDocument[] @relation("InquiryDocumentUploadedBy")
  uploadedCatalogDocuments ItemCatalogDocument[] @relation("CatalogDocumentUploadedBy")
  uploadedShipmentDocuments ShipmentDocument[]  @relation("ShipmentDocumentUploadedBy")
  shipmentEditRequestsMade  ShipmentEditRequest[] @relation("ShipmentEditRequestedBy")
  shipmentEditRequestsDecided ShipmentEditRequest[] @relation("ShipmentEditDecidedBy")
  priceChangeRequestsMade    FinancialProposalPriceChangeRequest[] @relation("PriceChangeRequestedBy")
  priceChangeRequestsDecided FinancialProposalPriceChangeRequest[] @relation("PriceChangeDecidedBy")
  rfqsAsCommercialExpert SupplierRfq[]         @relation("RfqCommercialExpert")
  rfqDeleteRequestsMade    RfqDeleteRequest[]  @relation("RfqDeleteRequestedBy")
  rfqDeleteRequestsDecided RfqDeleteRequest[]  @relation("RfqDeleteDecidedBy")
  selectionExchangeRatesUpdated InquirySelectionExchangeRate[] @relation("SelectionExchangeRateUpdatedBy")
  freightRfqsAsCommercialExpert FreightRfq[]   @relation("FreightRfqCommercialExpert")
  shipmentsAsCommercialExpert   Shipment[]     @relation("ShipmentCommercialExpert")
  lettersCreated                Letter[]              @relation("LetterCreatedBy")
  lettersResponsibleFor         Letter[]              @relation("LetterResponsibleUser")
  letterSignatures              LetterSigner[]         @relation("LetterSignerUser")
  letterWorkflowLogsPerformed   LetterWorkflowLog[]    @relation("WorkflowPerformedBy")
  letterWorkflowLogsReferredTo  LetterWorkflowLog[]    @relation("WorkflowReferredTo")
  letterAuditLogs               LetterAuditLog[]       @relation("LetterAuditUser")
  documentsUploaded             Document[]             @relation("DocumentUploadedBy")
  notifications                 Notification[]
  chatConversationsCreated      ChatConversation[]
  chatParticipations            ChatParticipant[]
  chatMessagesSent              ChatMessage[]
  identityDocuments             UserIdentityDocument[]
  activitiesAssigned            Activity[]             @relation("ActivityAssignedTo")
  activitiesCreated              Activity[]             @relation("ActivityCreatedBy")
  activityOutcomeTemplatesCreated ActivityOutcomeTemplate[]
  taskWatching                    TaskWatcher[]          @relation("TaskWatcherUser")
  taskWatchersAdded               TaskWatcher[]          @relation("TaskWatcherAddedBy")
  taskTimelineEntries             TaskTimelineEntry[]
  employees                       Employee[]
  payrollRuleVersionsCreated      PayrollRuleVersion[]
  payrollAuditLogsPerformed       PayrollAuditLog[]
  siteSettingsUpdated             SiteSettings[]         @relation("SiteSettingsUpdatedBy")
  broadcastMessagesCreated        BroadcastMessage[]      @relation("BroadcastCreatedBy")
  broadcastMessagesTargeted       BroadcastMessage[]      @relation("BroadcastTargetUser")
  broadcastMessageDismissals      BroadcastMessageDismissal[]

  @@map("users")
}

model UserIdentityDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(30)
  pageNumber   Int?     @map("page_number")
  fileUrl      String   @map("file_url")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_identity_documents")
}

model Permission {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module           String  @db.VarChar(50)
  permissionKey    String  @unique @map("permission_key") @db.VarChar(100)
  permissionLabel  String  @map("permission_label") @db.VarChar(300)
  supportsLimit    Boolean @default(false) @map("supports_limit")

  groupItems PermissionGroupItem[]

  @@map("permissions")
}

model PermissionGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupName String   @map("group_name") @db.VarChar(150)
  isDefault Boolean  @default(false) @map("is_default")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  creator User?                @relation("PermissionGroupCreatedBy", fields: [createdBy], references: [id])
  users   User[]                @relation("UserPermissionGroup")
  items   PermissionGroupItem[]
  broadcastMessagesTargeted BroadcastMessage[] @relation("BroadcastTargetGroup")

  @@map("permission_groups")
}

model PermissionGroupItem {
  permissionGroupId String   @map("permission_group_id") @db.Uuid
  permissionId       String   @map("permission_id") @db.Uuid
  limitValue         Decimal? @map("limit_value") @db.Decimal(18, 2)

  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionGroupId, permissionId])
  @@map("permission_group_items")
}

model BusinessPartner {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerType        String   @map("partner_type") @db.VarChar(20)
  companyName        String   @map("company_name") @db.VarChar(300)
  country            String?  @db.VarChar(100)
  industry           String?  @db.VarChar(150)
  address            String?
  // فاز ۳۷ — دوزبانه، برای پیشنهاد/پیش‌فاکتور انگلیسی (فاز ۳۸)
  companyNameEn      String?  @map("company_name_en") @db.VarChar(300)
  addressEn          String?  @map("address_en")
  // فاز ۵۱ — کد اختصاری لاتین؛ اگه کاربر وارد نکنه، خودکار از حروف اول company_name_en ساخته می‌شه
  shortCodeEn        String?  @map("short_code_en") @db.VarChar(20)
  taxId              String?  @map("tax_id") @db.VarChar(100)
  province           String?  @db.VarChar(100)
  city               String?  @db.VarChar(100)
  postalCode         String?  @map("postal_code") @db.VarChar(20)
  phone              String?  @db.VarChar(30)
  email              String?  @db.VarChar(200)
  nationalId         String?  @map("national_id") @db.VarChar(20)
  registrationNumber String?  @map("registration_number") @db.VarChar(50)
  notes              String?
  createdBy          String?  @map("created_by") @db.Uuid
  status             String   @default("active") @db.VarChar(20)
  phones             Json?    // آرایه شماره تلفن‌ها
  fax                String?  @db.VarChar(30)
  registrationDate   DateTime? @map("registration_date") @db.Date
  logoUrl            String?  @map("logo_url")
  isForeign          Boolean  @default(false) @map("is_foreign")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz

  contacts  PartnerContact[]
  inquiries Inquiry[]        @relation("InquiryBuyer")
  rfqs      SupplierRfq[]    @relation("RfqSupplier")
  orderItemsAsSupplier OrderItem[] @relation("OrderItemSupplier")
  purchaseOrdersAsSupplier PurchaseOrder[] @relation("PurchaseOrderSupplier")
  freightRfqsAsCompany     FreightRfq[]    @relation("FreightRfqCompany")
  shipmentsAsFreightCompany Shipment[]     @relation("ShipmentFreightCompany")
  lettersAsSender           Letter[]       @relation("LetterSenderPartner")
  lettersAsReceiver         Letter[]       @relation("LetterReceiverPartner")
  proposalClientCounters    ProposalClientCounter[]

  @@map("business_partners")
}

model PartnerContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String   @map("partner_id") @db.Uuid
  contactName String   @map("contact_name") @db.VarChar(200)
  // فاز ۳۷ — دوزبانه، برای پیشنهاد/پیش‌فاکتور انگلیسی (فاز ۳۸)
  contactNameEn String? @map("contact_name_en") @db.VarChar(200)
  contactType String?  @map("contact_type") @db.VarChar(30)
  level       String?  @db.VarChar(20)
  phone       String?  @db.VarChar(30)
  mobile      String?  @db.VarChar(30)
  email       String?  @db.VarChar(200)
  department  String?  @db.VarChar(150)
  extension   String?  @db.VarChar(20)
  photoUrl    String?  @map("photo_url")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]       @relation("InquiryBuyerContact")
  lettersAsSenderContact   Letter[] @relation("LetterSenderContact")
  lettersAsReceiverContact Letter[] @relation("LetterReceiverContact")

  @@map("partner_contacts")
}

model ItemCatalog {
  itemCode               String   @id @map("item_code") @db.VarChar(100)
  partNumber             String   @map("part_number") @db.VarChar(200)
  itemDescription        String   @map("item_description")
  builder                String?  @db.VarChar(200)
  defaultMeasurementUnit String?  @map("default_measurement_unit") @db.VarChar(30)
  createdBy              String?  @map("created_by") @db.Uuid
  status                 String   @default("active") @db.VarChar(20)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  inquiryItems InquiryItem[]
  documents    ItemCatalogDocument[]

  @@map("item_catalog")
}

model ItemCatalogDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemCode   String   @map("item_code") @db.VarChar(100)
  fileUrl    String   @map("file_url")
  fileName   String?  @map("file_name") @db.VarChar(300)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  item     ItemCatalog @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
  uploader User?       @relation("CatalogDocumentUploadedBy", fields: [uploadedBy], references: [id])

  @@map("item_catalog_documents")
}

// ============================================================
// دامنه ۲: استعلام — فاز ۳
// ستون‌های مرحله «انتخاب نهایی» (selected_offer_item_id و ...) در baseline با
// ALTER اضافه شدن؛ اینجا به‌صورت اسکالر می‌آن چون جدول‌های دامنه ۳ هنوز مدل ندارن
// ============================================================

model Inquiry {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalNumber           String    @unique @map("internal_number") @db.VarChar(50)
  inquiryNumber            String?   @map("inquiry_number") @db.VarChar(100)
  buyerId                  String    @map("buyer_id") @db.Uuid
  buyerContactId           String?   @map("buyer_contact_id") @db.Uuid
  subject                  String    @db.VarChar(300)
  offerEndDate             DateTime  @map("offer_end_date") @db.Date
  extendedOfferEndDate     DateTime? @map("extended_offer_end_date") @db.Date
  isEquivalentAccepted     Boolean?  @map("is_equivalent_accepted")
  settlementTerms          String?   @map("settlement_terms")
  advancePaymentAvailable  Boolean?  @map("advance_payment_available")
  description              String?
  salesExpertId            String    @map("sales_expert_id") @db.Uuid
  createdByUserId          String    @map("created_by_user_id") @db.Uuid
  inquiryStartDate         DateTime  @map("inquiry_start_date") @db.Date
  status                   String    @default("in_progress") @db.VarChar(30)
  channel                  String?   @db.VarChar(30)
  urgency                  String?   @default("normal") @db.VarChar(20)
  managerNoteToSales       String?   @map("manager_note_to_sales")
  selectionLockedAt        DateTime? @map("selection_locked_at") @db.Timestamptz
  selectionLockedBy        String?   @map("selection_locked_by") @db.Uuid
  // فاز ۵۷ — ارز مبنای مرحله «انتخاب نهایی و قیمت‌گذاری»؛ وقتی پر باشه، قیمت فروش نهایی
  // هر قلم بر همین ارز محاسبه می‌شه (نگاه کنید به inquiry_selection_exchange_rates)
  selectionBaseCurrencyCode String?  @map("selection_base_currency_code") @db.VarChar(3)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy                String?   @map("deleted_by") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  buyer            BusinessPartner     @relation("InquiryBuyer", fields: [buyerId], references: [id])
  buyerContact     PartnerContact?     @relation("InquiryBuyerContact", fields: [buyerContactId], references: [id])
  salesExpert      User                @relation("InquirySalesExpert", fields: [salesExpertId], references: [id])
  createdBy        User                @relation("InquiryCreatedBy", fields: [createdByUserId], references: [id])
  selectionLocker  User?               @relation("InquirySelectionLockedBy", fields: [selectionLockedBy], references: [id])
  selectionBaseCurrency Currency?      @relation(fields: [selectionBaseCurrencyCode], references: [currencyCode])
  items            InquiryItem[]
  documents        InquiryDocument[]
  discussions      InquiryDiscussion[]
  rfqs             SupplierRfq[]
  deliveryOptions  InquiryDeliveryOption[]
  selectionExchangeRates InquirySelectionExchangeRate[]
  financialProposals FinancialProposal[]
  technicalProposals TechnicalProposal[]
  orders             Order[]
  letters            Letter[]            @relation("LetterRelatedInquiry")

  @@map("inquiries")
}

// فاز ۵۷ — نرخ تبدیل دستی هر ارز آفر تأمین‌کننده به ارز مبنای انتخاب‌شده برای این پرونده
// (نه exchange_rates سراسری که فقط برای تبدیل به ریاله) — هر ارز مبدأ برای هر پرونده یک نرخه
model InquirySelectionExchangeRate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId        String   @map("inquiry_id") @db.Uuid
  fromCurrencyCode String   @map("from_currency_code") @db.VarChar(3)
  rate             Decimal  @db.Decimal(18, 6)
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromCurrency Currency @relation(fields: [fromCurrencyCode], references: [currencyCode])
  updater      User?    @relation("SelectionExchangeRateUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([inquiryId, fromCurrencyCode], map: "uq_selection_exchange_rate_inquiry_currency")
  @@map("inquiry_selection_exchange_rates")
}

model InquiryItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId           String   @map("inquiry_id") @db.Uuid
  rowIndex            Int      @map("row_index")
  itemCode            String   @map("item_code") @db.VarChar(100)
  description         String
  quantity            Decimal  @db.Decimal(18, 4)
  measurementUnit     String   @map("measurement_unit") @db.VarChar(30)
  equivalentType      String?  @map("equivalent_type") @db.VarChar(200)
  drawingTypeRow      String?  @map("drawing_type_row") @db.VarChar(200)
  partNumber          String?  @map("part_number") @db.VarChar(200)
  drawingNumber       String?  @map("drawing_number") @db.VarChar(200)
  builder             String?  @db.VarChar(200)
  serialNumber        String?  @map("serial_number") @db.VarChar(200)
  selectedOfferItemId String?  @map("selected_offer_item_id") @db.Uuid
  selectionNotes      String?  @map("selection_notes")
  markupPercent       Decimal? @map("markup_percent") @db.Decimal(6, 3)
  finalSalePrice      Decimal? @map("final_sale_price") @db.Decimal(18, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz

  inquiry           Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  catalogItem       ItemCatalog           @relation(fields: [itemCode], references: [itemCode])
  documents         InquiryItemDocument[]
  rfqItems          RfqItem[]
  offerItems        SupplierOfferItem[]   @relation("OfferItemInquiryItem")
  selectedOfferItem SupplierOfferItem?    @relation("SelectedOfferItem", fields: [selectedOfferItemId], references: [id])
  financialProposalItems FinancialProposalItem[]
  technicalProposalItems TechnicalProposalItem[]
  outcome                InquiryItemOutcome?
  orderItems              OrderItem[]
  warehouseReceiptItems   WarehouseReceiptItem[]

  @@unique([inquiryId, rowIndex])
  @@map("inquiry_items")
}

// نتیجه نهایی برد/باخت هر قلم — فاز ۷ (جدول در baseline موجوده)
model InquiryItemOutcome {
  inquiryItemId    String    @id @map("inquiry_item_id") @db.Uuid
  result           String    @db.VarChar(20)
  decisionDate     DateTime? @map("decision_date") @db.Date
  lossReason       String?   @map("loss_reason") @db.VarChar(50)
  competitorName   String?   @map("competitor_name") @db.VarChar(200)
  competitorPrice  Decimal?  @map("competitor_price") @db.Decimal(18, 4)
  winReason        String?   @map("win_reason") @db.VarChar(100)
  expertNote       String?   @map("expert_note")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  inquiryItem InquiryItem @relation(fields: [inquiryItemId], references: [id], onDelete: Cascade)

  @@map("inquiry_item_outcomes")
}

// ============================================================
// دامنه ۵: اجرای سفارش — سفارش مشتری — فاز ۸ (جدول‌ها در baseline موجودن)
// ============================================================

model Order {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      String    @unique @map("order_number") @db.VarChar(50)
  inquiryId        String    @map("inquiry_id") @db.Uuid
  contractNumber   String?   @map("contract_number") @db.VarChar(100)
  contractDate     DateTime? @map("contract_date") @db.Date
  totalAmount      Decimal   @map("total_amount") @db.Decimal(18, 4)
  deliveryDueDate  DateTime? @map("delivery_due_date") @db.Date
  contractFileUrl  String?   @map("contract_file_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  inquiry           Inquiry            @relation(fields: [inquiryId], references: [id])
  items             OrderItem[]
  customerPayments  CustomerPayment[]
  issuedGuarantees  IssuedGuarantee[]
  purchaseOrders    PurchaseOrder[]
  deliveries        Delivery[]
  invoices          Invoice[]

  @@map("orders")
}

model OrderItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  inquiryItemId String  @map("inquiry_item_id") @db.Uuid
  supplierId    String  @map("supplier_id") @db.Uuid
  purchasePrice Decimal @map("purchase_price") @db.Decimal(18, 4)
  salePrice     Decimal @map("sale_price") @db.Decimal(18, 4)
  quantity      Decimal @db.Decimal(18, 4)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inquiryItem InquiryItem     @relation(fields: [inquiryItemId], references: [id])
  supplier    BusinessPartner @relation("OrderItemSupplier", fields: [supplierId], references: [id])
  poItems     PoItem[]

  @@unique([orderId, inquiryItemId])
  @@map("order_items")
}

// ============================================================
// دامنه ۵: اجرای سفارش — سفارش خرید (PO) — فاز ۹ (جدول‌ها در baseline موجودن)
// ============================================================

model PurchaseOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poNumber        String    @unique @map("po_number") @db.VarChar(50)
  orderId         String    @map("order_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  ourEntityId     String    @map("our_entity_id") @db.Uuid
  currencyCode    String    @map("currency_code") @db.VarChar(3)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(18, 4)
  issueDate       DateTime  @map("issue_date") @db.Date
  deliveryDueDate DateTime? @map("delivery_due_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  order            Order              @relation(fields: [orderId], references: [id])
  supplier         BusinessPartner    @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id])
  ourEntity        OurEntity          @relation(fields: [ourEntityId], references: [id])
  currency         Currency           @relation(fields: [currencyCode], references: [currencyCode])
  items            PoItem[]
  supplierPayments SupplierPayment[]
  productionTracking ProductionTracking?
  packages         Package[]

  @@map("purchase_orders")
}

model PoItem {
