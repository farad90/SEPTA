// ============================================================
// دامنه ۴: پیشنهاد به مشتری — فاز ۶ (جدول‌ها در baseline موجودن)
// ============================================================

model FinancialProposal {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalNumber       String    @map("proposal_number") @db.VarChar(50)
  inquiryId            String    @map("inquiry_id") @db.Uuid
  version              Int       @default(1)
  status               String    @default("current") @db.VarChar(20)
  preparedDate         DateTime  @map("prepared_date") @db.Date
  currencyCode         String    @map("currency_code") @db.VarChar(3)
  chosenDeliveryTerm   String    @map("chosen_delivery_term") @db.VarChar(10)
  deliveryDays         Int       @map("delivery_days")
  // فاز ۵۶ — واحد نمایشی زمان تحویل که کارشناس هنگام تایپ انتخاب کرده (day/week)؛ خودِ
  // deliveryDays همیشه به روز ذخیره می‌شه، این ستون فقط برای نمایش صحیح در UI/سنده
  deliveryDaysUnit     String    @default("day") @map("delivery_days_unit") @db.VarChar(10)
  paymentTerms         String?   @map("payment_terms")
  proposalValidityDate DateTime? @map("proposal_validity_date") @db.Date
  negotiationNote      String?   @map("negotiation_note")
  fileUrl              String?   @map("file_url")
  sentAt               DateTime? @map("sent_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // فاز ۳۸ — شرکت گروه صادرکننده این نسخه از پیشنهاد (برای سربرگ سند PDF/Word)
  ourEntityId          String?   @map("our_entity_id") @db.Uuid
  // فاز ۵۱ — Incoterm (محل تحویل) و روش حمل، برای درج در سند
  incotermLocation     String?   @map("incoterm_location") @db.VarChar(200)
  shippingMethod       String?   @map("shipping_method") @db.VarChar(100)
  // فاز ۵۱ — فقط وقتی این نسخه از تبدیل ارز نسخه قبلی ساخته شده باشه پر می‌شه
  exchangeRateFromCurrency String? @map("exchange_rate_from_currency") @db.VarChar(3)
  exchangeRateToCurrency   String? @map("exchange_rate_to_currency") @db.VarChar(3)
  exchangeRateValue        Decimal? @map("exchange_rate_value") @db.Decimal(18, 6)
  // فاز ۵۲ — الهام از نمونه "Sales Order Confirmation" یک شرکت دیگه (Bitax Group)
  paymentMethod          String?  @map("payment_method") @db.VarChar(50)
  partialShipmentAllowed Boolean  @default(true) @map("partial_shipment_allowed")
  documentsChecklist     String[] @default([]) @map("documents_checklist")
  serviceTest            String?  @map("service_test") @db.VarChar(100)
  serviceFieldService    String?  @map("service_field_service") @db.VarChar(100)
  serviceDesign          String?  @map("service_design") @db.VarChar(100)
  warrantyTerms          String?  @map("warranty_terms")
  // ⚠️ عمداً جدا از negotiationNote (یادداشت داخلی مذاکره) — این متن مستقیم در سند چاپ می‌شه
  remarks                String?

  inquiry   Inquiry                  @relation(fields: [inquiryId], references: [id])
  currency  Currency                 @relation(fields: [currencyCode], references: [currencyCode])
  ourEntity OurEntity?               @relation(fields: [ourEntityId], references: [id])
  items     FinancialProposalItem[]

  @@unique([inquiryId, version])
  @@map("financial_proposals")
}

