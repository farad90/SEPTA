model OurEntity {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityName   String @map("entity_name") @db.VarChar(200)
  shortCode    String @unique @map("short_code") @db.VarChar(10)
  calendarType String @default("jalali") @map("calendar_type") @db.VarChar(10)
  country      String @db.VarChar(100)
  status       String @default("active") @db.VarChar(20)

  // فاز ۳۶ — فیلدهای سربرگ/تماس، برای پنل مدیریتی «شرکت‌های ما»
  entityNameEn String? @map("entity_name_en") @db.VarChar(200)
  address      String?
  addressEn    String? @map("address_en")
  phone        String? @db.VarChar(30)
  email        String? @db.VarChar(200)
  website      String? @db.VarChar(200)
  logoUrl      String? @map("logo_url")

  // فاز ۳۸ — فوتر سند پیشنهاد (PDF/Word)
  postalCode         String? @map("postal_code") @db.VarChar(20)
  registrationNumber String? @map("registration_number") @db.VarChar(50)

  rfqs           SupplierRfq[]
  purchaseOrders PurchaseOrder[]
  lettersAsSender   Letter[] @relation("LetterSenderEntity")
  lettersAsReceiver Letter[] @relation("LetterReceiverEntity")
  lettersIssued     Letter[] @relation("LetterIssuingEntity")
  letterCounters    LetterCounter[]
  proposalCounters  ProposalCounter[]
  departments        Department[]
  employees          Employee[]
  employeeContracts  EmployeeContract[]
  legacyPayrollPeriods LegacyPayrollPeriod[]
  financialProposals FinancialProposal[]
  technicalProposals TechnicalProposal[]

  @@map("our_entities")
}

model Department {
