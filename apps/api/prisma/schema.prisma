  rfqNumber          String   @unique @map("rfq_number") @db.VarChar(50)
  freightCompanyId   String   @map("freight_company_id") @db.Uuid
  commercialExpertId String   @map("commercial_expert_id") @db.Uuid
  destinationCustoms String   @map("destination_customs") @db.VarChar(200)
  emailSubject       String?  @map("email_subject") @db.VarChar(300)
  sentDate           DateTime @map("sent_date") @db.Date
  status             String   @default("awaiting_response") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz

  freightCompany   BusinessPartner     @relation("FreightRfqCompany", fields: [freightCompanyId], references: [id])
  commercialExpert User                @relation("FreightRfqCommercialExpert", fields: [commercialExpertId], references: [id])
