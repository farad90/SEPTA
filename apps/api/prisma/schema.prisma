// ============================================================
// فاز ۱۴ — اعلان‌ها، یادآورها (TODO)، پیام‌رسانی سراسری (دامنه ۹)
// ============================================================

model Notification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  type               String    @db.VarChar(40)
  title              String    @db.VarChar(200)
  message            String?
  relatedEntityType  String?   @map("related_entity_type") @db.VarChar(30)
  relatedEntityId    String?   @map("related_entity_id") @db.Uuid
  actions            Json?
  isRead             Boolean   @default(false) @map("is_read")
  isActioned         Boolean   @default(false) @map("is_actioned")
  actionedAt         DateTime? @map("actioned_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Activity {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityType           String    @map("activity_type") @db.VarChar(30)
  subject                String    @db.VarChar(300)
  description            String?
  relatedEntityType      String?   @map("related_entity_type") @db.VarChar(30)
  relatedEntityId        String?   @map("related_entity_id") @db.Uuid
  priority               String    @default("normal") @db.VarChar(20)
  status                 String    @default("open") @db.VarChar(20)
  scheduledAt            DateTime? @map("scheduled_at") @db.Timestamptz
  dueAt                  DateTime? @map("due_at") @db.Timestamptz
  completedAt            DateTime? @map("completed_at") @db.Timestamptz
  waitingReason          String?   @map("waiting_reason")
  assignedToUserId       String    @map("assigned_to_user_id") @db.Uuid
  createdByUserId        String    @map("created_by_user_id") @db.Uuid
  outcomeNote            String?   @map("outcome_note")
  outcomeId              String?   @map("outcome_id") @db.Uuid
  followUpOfActivityId   String?   @map("follow_up_of_activity_id") @db.Uuid
  callRecordingUrl       String?   @map("call_recording_url")
  aiSummary              String?   @map("ai_summary")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  assignedTo     User                    @relation("ActivityAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy      User                    @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id])
  followUpOf     Activity?               @relation("ActivityFollowUp", fields: [followUpOfActivityId], references: [id])
  followUps      Activity[]              @relation("ActivityFollowUp")
  outcome        ActivityOutcomeTemplate? @relation(fields: [outcomeId], references: [id])
  watchers       TaskWatcher[]
  timeline       TaskTimelineEntry[]

  @@map("activities")
}

// Work Management — دنبال‌کنندگان یک Task (Watcher)؛ Creator خودکار Watcher می‌شه
model TaskWatcher {
  taskId        String   @map("task_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz

  task    Activity @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User     @relation("TaskWatcherUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User     @relation("TaskWatcherAddedBy", fields: [addedByUserId], references: [id])

  @@id([taskId, userId])
  @@map("task_watchers")
}

// Work Management — تاریخچهٔ کامل هر Task (کامنت آزاد + لاگ خودکار سیستم)، هم‌الگوی inquiry_discussions
model TaskTimelineEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  entryType  String   @map("entry_type") @db.VarChar(20) // "comment" | "activity"
  authorId   String   @map("author_id") @db.Uuid
  entryText  String   @map("entry_text")
  actionKind String?  @map("action_kind") @db.VarChar(30)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  task   Activity @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id])

  @@map("task_timeline_entries")
}

model ActivityOutcomeTemplate {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityType           String    @map("activity_type") @db.VarChar(30)
  label                  String    @db.VarChar(200)
  isDefault              Boolean   @default(false) @map("is_default")
  requiresFollowUp       Boolean   @default(false) @map("requires_follow_up")
  followUpActivityType   String?   @map("follow_up_activity_type") @db.VarChar(30)
  followUpOffsetMinutes  Int?      @map("follow_up_offset_minutes")
  // اثر ثبت این نتیجه روی Task — جایگزین منطقی requiresFollowUp (که برای سازگاری
  // تاریخی باقی مونده، دیگه خونده نمی‌شه): close=بستن، create_follow_up=پیگیری
  // (پیش‌فرض همون Task با سررسید جدید، مگر کاربر صراحتاً Task مستقل بخواد)،
  // keep_waiting=انتقال به وضعیت انتظار با یک دلیل
  effect                 String    @default("close") @db.VarChar(20)
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  createdBy  User?      @relation(fields: [createdByUserId], references: [id])
  activities Activity[]

  @@unique([activityType, label])
  @@map("activity_outcome_templates")
}

model ChatConversation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationType String   @default("direct") @map("conversation_type") @db.VarChar(10)
  groupName        String?  @map("group_name") @db.VarChar(150)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  creator      User              @relation(fields: [createdBy], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_conversations")
}

model ChatParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  messageText    String    @map("message_text")
  fileUrl        String?   @map("file_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  editedAt       DateTime? @map("edited_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

// ============================================================
// دامنه ۱۲: موتور حقوق و دستمزد قانون‌محور (Payroll Engine) — فاز ۴۱
// ⚠️ جایگزین جداول ساده‌ی قدیمی LegacyPayrollPeriod/LegacyPayslip/LegacyPayslipItem
// (تصمیم تأییدشده §00-الف: جایگزینی نرم — جدول‌های قدیمی Deprecated، نه حذف).
// هیچ عدد/درصد/سقف/فرمولی هاردکد نیست؛ همه از PayrollRule/PayrollTaxBracket/Formula خونده می‌شه.
// ============================================================

model PayrollYear {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  yearNumber   Int      @unique @map("year_number")
  calendarType String   @default("jalali") @map("calendar_type") @db.VarChar(10) // jalali | gregorian
  status       String   @default("open") @db.VarChar(20) // open | closed
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  ruleVersions PayrollRuleVersion[]
  periods      PayrollPeriod[]

  @@map("payroll_years")
}

model PayrollRuleVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollYearId String    @map("payroll_year_id") @db.Uuid
  versionNumber Int       @map("version_number")
  title         String    @db.VarChar(200) // مثلاً "1406 Version 1"
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  status        String    @default("draft") @db.VarChar(20) // draft | active | superseded
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  payrollYear PayrollYear         @relation(fields: [payrollYearId], references: [id])
  createdBy   User?               @relation(fields: [createdById], references: [id])
  rules       PayrollRule[]
  brackets    PayrollTaxBracket[]
  formulas    Formula[]
  periods     PayrollPeriod[]
  defaultForProfiles EmployeePayrollProfile[]

  @@unique([payrollYearId, versionNumber])
  @@map("payroll_rule_versions")
}

model PayrollRule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleVersionId String    @map("rule_version_id") @db.Uuid
  code          String    @db.VarChar(100) // MIN_WAGE, HOUSING_ALLOWANCE, INSURANCE_RATE_EMPLOYEE, INSURANCE_CEILING, ...
  title         String    @db.VarChar(300)
  valueType     String    @map("value_type") @db.VarChar(20) // number | percent | boolean
  value         Decimal   @db.Decimal(18, 4)
  effectiveDate DateTime  @map("effective_date") @db.Date
  expireDate    DateTime? @map("expire_date") @db.Date
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ruleVersion PayrollRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@unique([ruleVersionId, code])
  @@map("payroll_rules")
}

// پله‌های مالیات پلکانی — ذاتاً چندردیفی است، در قالب PayrollRule تک‌مقداره جا نمی‌شود
model PayrollTaxBracket {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleVersionId String   @map("rule_version_id") @db.Uuid
  bracketOrder  Int      @map("bracket_order")
  fromAmount    Decimal  @map("from_amount") @db.Decimal(18, 4)
  toAmount      Decimal? @map("to_amount") @db.Decimal(18, 4) // null = آخرین پله، بدون سقف
  ratePercent   Decimal  @map("rate_percent") @db.Decimal(5, 2)

  ruleVersion PayrollRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@unique([ruleVersionId, bracketOrder])
  @@map("payroll_tax_brackets")
}

model Formula {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleVersionId String   @map("rule_version_id") @db.Uuid
  code          String   @db.VarChar(100)
  expression    String   @db.Text // "BASE + HOUSE + FOOD" یا "IF(CHILDREN>0, CHILDREN*CHILD_ALLOWANCE, 0)"
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  ruleVersion PayrollRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  components  PayrollComponent[]

  @@unique([ruleVersionId, code])
  @@map("payroll_formulas")
}

model PayrollComponent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique @db.VarChar(50) // BASE, HOUSE, FOOD, CHILD, SENIORITY, OVERTIME, NIGHT, HOLIDAY, BONUS, INSURANCE, TAX, LOAN, ADVANCE, OTHER
  title         String   @db.VarChar(200)
  componentType String   @map("component_type") @db.VarChar(10) // earning | deduction
  isInsurable   Boolean  @default(false) @map("is_insurable")
  isTaxable     Boolean  @default(false) @map("is_taxable")
  calcOrder     Int      @default(0) @map("calc_order") // راهنمای نمایش؛ ترتیب واقعی محاسبه از Dependency Engine می‌آید
  formulaId     String?  @map("formula_id") @db.Uuid
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  formula     Formula?            @relation(fields: [formulaId], references: [id])
  resultItems PayrollResultItem[]

  @@map("payroll_components")
}

// عمداً باریک نگه داشته شده — حقوق پایه/نوع قرارداد از employee_contracts، تأهل از employees خوانده می‌شود
model EmployeePayrollProfile {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId           String    @unique @map("employee_id") @db.Uuid
  seniorityBaseDate    DateTime? @map("seniority_base_date") @db.Date // پیش‌فرض = hire_date؛ فقط برای override دستی پر می‌شود
  childrenCount        Int       @default(0) @map("children_count") // ⚠️ Deprecated فاز ۴۲ — جایگزین شد با EmployeeChild (تاریخ تولد)؛ ستون برای Rollback باقی مانده، دیگر توسط Pipeline خوانده نمی‌شود
  insuranceNumber      String?   @map("insurance_number") @db.VarChar(50)
  costCenterDeptId     String?   @map("cost_center_dept_id") @db.Uuid
  defaultRuleVersionId String?   @map("default_rule_version_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  costCenter  Department?         @relation(fields: [costCenterDeptId], references: [id])
  defaultRule PayrollRuleVersion? @relation(fields: [defaultRuleVersionId], references: [id])

  @@map("employee_payroll_profiles")
}

model PayrollPeriod {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollYearId String   @map("payroll_year_id") @db.Uuid
  periodCode    String   @unique @map("period_code") @db.VarChar(10) // "1406-01"
  monthNumber   Int      @map("month_number")
  ruleVersionId String   @map("rule_version_id") @db.Uuid // کدام نسخه‌ی قانون برای این ماه معتبر است — ثابت پس از ساخت
  status        String   @default("open") @db.VarChar(20) // open | closed
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  payrollYear PayrollYear        @relation(fields: [payrollYearId], references: [id])
  ruleVersion PayrollRuleVersion @relation(fields: [ruleVersionId], references: [id])
  workLogs    PayrollWorkLog[]
  results     PayrollResult[]

  @@map("payroll_periods_v2") // نام‌گذاری متفاوت از جدول قدیمی payroll_periods (اکنون LegacyPayrollPeriod)
}

// Snapshot تجمیعی خودکار از attendance_records/leave_requests/overtime_records/mission_requests
// (تصمیم تأییدشده §00-ب) — با قابلیت اصلاح دستی برای موارد استثنا (source='manual')
model PayrollWorkLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollPeriodId   String   @map("payroll_period_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  workedDays        Decimal  @default(0) @map("worked_days") @db.Decimal(5, 2)
  overtimeHours     Decimal  @default(0) @map("overtime_hours") @db.Decimal(6, 2)
  nightHours        Decimal  @default(0) @map("night_hours") @db.Decimal(6, 2)
  fridayHours       Decimal  @default(0) @map("friday_hours") @db.Decimal(6, 2)
  holidayHours      Decimal  @default(0) @map("holiday_hours") @db.Decimal(6, 2)
  missionDays       Decimal  @default(0) @map("mission_days") @db.Decimal(5, 2)
  leaveDays         Decimal  @default(0) @map("leave_days") @db.Decimal(5, 2)
  absenceDays       Decimal  @default(0) @map("absence_days") @db.Decimal(5, 2)
  latenessMinutes   Int      @default(0) @map("lateness_minutes")
  earlyLeaveMinutes Int      @default(0) @map("early_leave_minutes")
  requiredHours     Decimal  @default(0) @map("required_hours") @db.Decimal(6, 2)
  workedHours       Decimal  @default(0) @map("worked_hours") @db.Decimal(6, 2)
  source            String   @default("auto_aggregated") @db.VarChar(20) // auto_aggregated | manual
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_work_logs")
}

model PayrollResult {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollPeriodId        String    @map("payroll_period_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  status                 String    @default("draft") @db.VarChar(20) // draft|calculated|reviewed|approved|posted|locked
  grossEarnings          Decimal   @default(0) @map("gross_earnings") @db.Decimal(18, 4)
  totalDeductions        Decimal   @default(0) @map("total_deductions") @db.Decimal(18, 4)
  insuranceEmployeeShare Decimal   @default(0) @map("insurance_employee_share") @db.Decimal(18, 4)
  insuranceEmployerShare Decimal   @default(0) @map("insurance_employer_share") @db.Decimal(18, 4)
  unemploymentInsurance  Decimal   @default(0) @map("unemployment_insurance") @db.Decimal(18, 4)
  taxAmount              Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  netSalary              Decimal   @default(0) @map("net_salary") @db.Decimal(18, 4)
  employerCost           Decimal   @default(0) @map("employer_cost") @db.Decimal(18, 4)
  calculatedAt           DateTime? @map("calculated_at") @db.Timestamptz
  calculatedBy           String?   @map("calculated_by") @db.Uuid
  reviewedAt             DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy             String?   @map("reviewed_by") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz
  approvedBy             String?   @map("approved_by") @db.Uuid
  postedAt               DateTime? @map("posted_at") @db.Timestamptz
  postedBy               String?   @map("posted_by") @db.Uuid
  lockedAt               DateTime? @map("locked_at") @db.Timestamptz
  lockedBy               String?   @map("locked_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  payrollPeriod PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id])
  employee      Employee            @relation(fields: [employeeId], references: [id])
  items         PayrollResultItem[]

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_results")
}

// هر ردیف یک Snapshot است — حتی اگر بعداً عنوان Component یا متن فرمول عوض شود، تاریخچه دست‌نخورده می‌ماند
model PayrollResultItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollResultId String  @map("payroll_result_id") @db.Uuid
  componentId     String  @map("component_id") @db.Uuid
  componentCode   String  @map("component_code") @db.VarChar(50)
  amount          Decimal @db.Decimal(18, 4)
  calcOrder       Int     @map("calc_order")
  formulaSnapshot String? @map("formula_snapshot") @db.Text

  payrollResult PayrollResult    @relation(fields: [payrollResultId], references: [id], onDelete: Cascade)
  component     PayrollComponent @relation(fields: [componentId], references: [id])

  @@map("payroll_result_items")
}

model PayrollAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  action      String   @db.VarChar(20) // created | updated | deleted | status_changed
  fieldName   String?  @map("field_name") @db.VarChar(100)
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  performedBy String   @map("performed_by") @db.Uuid
  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz

  performedByUser User @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@map("payroll_audit_log")
}

// فاز ۴۱-ب — تنظیمات سراسری سامانه (تک‌ردیفی، الگوی CatalogCounter)
model SiteSettings {
  id                 Int       @id @default(1)
  loginBackgroundUrl String?   @map("login_background_url")
  updatedBy          String?   @map("updated_by") @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation("SiteSettingsUpdatedBy", fields: [updatedBy], references: [id])

  @@map("site_settings")
}

// فاز ۴۱-ج — پیام اعلامی مدیر در بدو ورود. بدون فن‌اوت رکورد در لحظه ایجاد؛
// کوئری «پیام‌های در انتظار من» در لحظه (BroadcastMessagesService.getPending) بررسی می‌شه.
model BroadcastMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageUrl      String?  @map("image_url")
  message       String
  targetType    String   @map("target_type") @db.VarChar(10) // "user" | "group" | "all"
  targetUserId  String?  @map("target_user_id") @db.Uuid
  targetGroupId String?  @map("target_group_id") @db.Uuid
  active        Boolean  @default(true)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  creator     User             @relation("BroadcastCreatedBy", fields: [createdBy], references: [id])
  targetUser  User?            @relation("BroadcastTargetUser", fields: [targetUserId], references: [id])
  targetGroup PermissionGroup? @relation("BroadcastTargetGroup", fields: [targetGroupId], references: [id])
  dismissals  BroadcastMessageDismissal[]

  @@map("broadcast_messages")
}

model BroadcastMessageDismissal {
  broadcastMessageId String   @map("broadcast_message_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  dismissedAt        DateTime @default(now()) @map("dismissed_at") @db.Timestamptz

  broadcastMessage BroadcastMessage @relation(fields: [broadcastMessageId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([broadcastMessageId, userId])
  @@map("broadcast_message_dismissals")
}
