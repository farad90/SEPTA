  ourEntity        OurEntity    @relation(fields: [ourEntityId], references: [id])
  parentDepartment Department?  @relation("DepartmentParent", fields: [parentDepartmentId], references: [id])
  childDepartments Department[] @relation("DepartmentParent")
  headEmployee     Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees        Employee[]   @relation("EmployeeDepartment")
  lettersFrom      Letter[]     @relation("LetterInternalFromDepartment")
  lettersTo        Letter[]     @relation("LetterInternalToDepartment")
  payrollCostCenterProfiles EmployeePayrollProfile[]

  @@map("departments")
}

model Employee {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String?   @map("user_id") @db.Uuid
  // ⚠️ Nullable — پرسنل با حساب کاربری، تا وقتی منابع انسانی شماره پرسنلی تخصیص نداده،
  // فقط «کاربر سامانه» محسوب می‌شن نه «کارمند رسمی شرکت» (نگاه کنید به EmployeesService)
  employeeNumber         String?   @unique @map("employee_number") @db.VarChar(30)
  fullName               String    @map("full_name") @db.VarChar(200)
  nationalId             String?   @map("national_id") @db.VarChar(20)
  birthDate              DateTime? @map("birth_date") @db.Date
  gender                 String?   @db.VarChar(10)
  mobile                 String?   @db.VarChar(30)
  email                  String?   @db.VarChar(200)
  address                String?
  maritalStatus          String?   @map("marital_status") @db.VarChar(20)
  militaryServiceStatus  String?   @map("military_service_status") @db.VarChar(30)
  educationLevel         String?   @map("education_level") @db.VarChar(30)
  profilePhotoUrl        String?   @map("profile_photo_url")
  bankAccountNumber      String?   @map("bank_account_number") @db.VarChar(50)
  bankName               String?   @map("bank_name") @db.VarChar(100)
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone  String?   @map("emergency_contact_phone") @db.VarChar(30)
  departmentId           String?   @map("department_id") @db.Uuid
  positionTitle          String?   @map("position_title") @db.VarChar(150)
  directManagerId        String?   @map("direct_manager_id") @db.Uuid
  // ⚠️ Nullable — تا زمان تخصیص شماره پرسنلی، شرکت گروه/تاریخ استخدام هنوز مشخص نشدن
  ourEntityId            String?   @map("our_entity_id") @db.Uuid
  hireDate               DateTime? @map("hire_date") @db.Date
  terminationDate        DateTime? @map("termination_date") @db.Date
  employmentStatus       String    @default("active") @map("employment_status") @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  user            User?               @relation(fields: [userId], references: [id])
  department      Department?         @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  directManager   Employee?           @relation("EmployeeManager", fields: [directManagerId], references: [id])
  reports         Employee[]          @relation("EmployeeManager")
  ourEntity       OurEntity?          @relation(fields: [ourEntityId], references: [id])
  headOfDepartments Department[]      @relation("DepartmentHead")
  contracts       EmployeeContract[]
  attendanceRecords    AttendanceRecord[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]    @relation("LeaveRequestEmployee")
  leaveRequestsApproved LeaveRequest[]   @relation("LeaveRequestApprover")
  missionRequests        MissionRequest[] @relation("MissionRequestEmployee")
  missionRequestsApproved MissionRequest[] @relation("MissionRequestApprover")
  overtimeRecords        OvertimeRecord[] @relation("OvertimeRecordEmployee")
  overtimeRecordsApproved OvertimeRecord[] @relation("OvertimeRecordApprover")
  loans                  EmployeeLoan[]   @relation("EmployeeLoanEmployee")
  loansApproved          EmployeeLoan[]   @relation("EmployeeLoanApprover")
  benefits               EmployeeBenefit[]
  deductions             EmployeeDeduction[]
  hrRequests             HrRequest[]      @relation("HrRequestEmployee")
  hrRequestsApproved     HrRequest[]      @relation("HrRequestApprover")
  legacyPayslips              LegacyPayslip[]
  payrollProfile              EmployeePayrollProfile?
  payrollWorkLogs             PayrollWorkLog[]
  payrollResults              PayrollResult[]
  performanceReviews          PerformanceReview[] @relation("PerformanceReviewEmployee")
  performanceReviewsAsReviewer PerformanceReview[] @relation("PerformanceReviewReviewer")
  children                     EmployeeChild[]

  @@map("employees")
}

// فاز ۴۲ — فرزندان با تاریخ تولد؛ جایگزین EmployeePayrollProfile.childrenCount (که Deprecated شد،
// ستون در دیتابیس باقی می‌مونه ولی دیگه توسط Pipeline خونده نمی‌شه) چون حق اولاد قانوناً فقط تا
// سقف سنی مشخص (Rule جداگانه CHILD_ALLOWANCE_MAX_AGE، نه هاردکد) پرداخت می‌شه — بدون تاریخ تولد
// امکان محاسبه‌ی خودکار این سقف سنی در هر دوره وجود نداشت.
model EmployeeChild {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  fullName   String?  @map("full_name") @db.VarChar(200)
  birthDate  DateTime @map("birth_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_children")
}

model EmployeeContract {
