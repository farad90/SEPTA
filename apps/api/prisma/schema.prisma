  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz

  item      FinancialProposalItem @relation(fields: [financialProposalItemId], references: [id], onDelete: Cascade)
  requester User                  @relation("PriceChangeRequestedBy", fields: [requestedBy], references: [id])
  decider   User?                 @relation("PriceChangeDecidedBy", fields: [decidedBy], references: [id])

  @@map("financial_proposal_price_change_requests")
}

model TechnicalProposal {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalNumber           String    @map("proposal_number") @db.VarChar(50)
  inquiryId                String    @map("inquiry_id") @db.Uuid
  version                  Int       @default(1)
  status                   String    @default("current") @db.VarChar(20)
  preparedDate             DateTime  @map("prepared_date") @db.Date
  deliveryTimeEstimateDays Int?      @map("delivery_time_estimate_days")
  // فاز ۵۶ — واحد نمایشی زمان تحویل (day/week)، هم‌الگوی financial_proposals.deliveryDaysUnit
  deliveryDaysUnit         String    @default("day") @map("delivery_days_unit") @db.VarChar(10)
  negotiationNote          String?   @map("negotiation_note")
  fileUrl                  String?   @map("file_url")
  sentAt                   DateTime? @map("sent_at") @db.Timestamptz
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // فاز ۳۸ — شرکت گروه صادرکننده این نسخه از پیشنهاد (برای سربرگ سند PDF/Word)
  ourEntityId              String?   @map("our_entity_id") @db.Uuid
  // فاز ۵۱ — این سه فیلد مستقل از financial_proposals نگه‌داری می‌شن (هم‌الگوی
  // delivery_time_estimate_days که از قبل جدا بود)، چون پیشنهاد فنی می‌تونه مستقل ارسال بشه
  chosenDeliveryTerm       String?   @map("chosen_delivery_term") @db.VarChar(10)
  incotermLocation         String?   @map("incoterm_location") @db.VarChar(200)
  shippingMethod           String?   @map("shipping_method") @db.VarChar(100)

  inquiry   Inquiry                 @relation(fields: [inquiryId], references: [id])
  ourEntity OurEntity?              @relation(fields: [ourEntityId], references: [id])
  items     TechnicalProposalItem[]

  @@unique([inquiryId, version])
  @@map("technical_proposals")
}

model TechnicalProposalItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicalProposalId String  @map("technical_proposal_id") @db.Uuid
  inquiryItemId       String  @map("inquiry_item_id") @db.Uuid
  technicalSpecs      String? @map("technical_specs")
  complianceNote      String? @map("compliance_note")

  proposal    TechnicalProposal @relation(fields: [technicalProposalId], references: [id], onDelete: Cascade)
  inquiryItem InquiryItem       @relation(fields: [inquiryItemId], references: [id])

  @@unique([technicalProposalId, inquiryItemId])
  @@map("technical_proposal_items")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// فاز ۱۱ — ماژول سراسری «مدیریت بارها» (دامنه ۶، بخش دوم)
// استعلام حمل + چرخه کامل ۶مرحله‌ای محموله/گمرک
// ============================================================

model FreightRfq {
