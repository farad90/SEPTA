model InquiryDiscussion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId       String   @map("inquiry_id") @db.Uuid
  entryType       String   @default("message") @map("entry_type") @db.VarChar(20)
  authorId        String   @map("author_id") @db.Uuid
  commentText     String   @map("comment_text")
  commentTextRestricted String? @map("comment_text_restricted")
  tag             String?  @default("general") @db.VarChar(30)
  metadata        Json?
  sourceRfqId     String?  @map("source_rfq_id") @db.Uuid
  mentionedUserId String?  @map("mentioned_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  inquiry   Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author    User         @relation("DiscussionAuthor", fields: [authorId], references: [id])
  mentioned User?        @relation("DiscussionMentioned", fields: [mentionedUserId], references: [id])
  // فاز ۵۷ — SetNull تا حذف قطعی RFQ (بعد از تأیید درخواست حذف) به رکوردهای گفتگو که قبلاً
  // به این RFQ اشاره کرده بودن برنخوره؛ متن پیام (که شماره RFQ داخلش هست) دست‌نخورده می‌مونه
