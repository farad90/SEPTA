  referredToUserId  String?  @map("referred_to_user_id") @db.Uuid
  note              String?
  performedAt       DateTime @default(now()) @map("performed_at") @db.Timestamptz

  letter       Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  performer    User   @relation("WorkflowPerformedBy", fields: [performedBy], references: [id])
  referredToUser User? @relation("WorkflowReferredTo", fields: [referredToUserId], references: [id])

  @@map("letter_workflow_logs")
}

model LetterAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letterId    String   @map("letter_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String   @db.VarChar(20)
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  user   User   @relation("LetterAuditUser", fields: [userId], references: [id])

  @@map("letter_audit_log")
