  consolidationFinalizeDate  DateTime? @map("consolidation_finalize_date") @db.Date
  billOfLadingNumber         String?   @map("bill_of_lading_number") @db.VarChar(100)
  loadingDate                DateTime? @map("loading_date") @db.Date
  vesselOrFlight             String?   @map("vessel_or_flight") @db.VarChar(200)
  originPort                 String?   @map("origin_port") @db.VarChar(150)
  destinationPort            String?   @map("destination_port") @db.VarChar(150)
  eta                        DateTime? @db.Date
  exportDeclarationNumber    String?   @map("export_declaration_number") @db.VarChar(100)
  exportDeclarationFileUrl   String?   @map("export_declaration_file_url")
  customsDeclarationNumber   String?   @map("customs_declaration_number") @db.VarChar(100)
  customsDeclarationFileUrl  String?   @map("customs_declaration_file_url")
  customsDutiesAmount        Decimal?  @map("customs_duties_amount") @db.Decimal(18, 4)
  clearanceFeesAmount        Decimal?  @map("clearance_fees_amount") @db.Decimal(18, 4)
  clearanceAgentName         String?   @map("clearance_agent_name") @db.VarChar(200)
  weighbridgeSlipFileUrl     String?   @map("weighbridge_slip_file_url")
  customsExitWaybillFileUrl  String?   @map("customs_exit_waybill_file_url")
  unlockedStage              String?   @map("unlocked_stage") @db.VarChar(30)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  commercialExpert     User             @relation("ShipmentCommercialExpert", fields: [commercialExpertId], references: [id])
  freightCompany       BusinessPartner? @relation("ShipmentFreightCompany", fields: [freightCompanyId], references: [id])
  selectedFreightOffer FreightOffer?    @relation("SelectedFreightOffer", fields: [selectedFreightOfferId], references: [id])
  packages             ShipmentPackage[]
  exportDocuments      ExportDocument?
  importDocuments      ImportDocument?
  warehouseReceipts    WarehouseReceipt[]
  letters              Letter[]           @relation("LetterRelatedShipment")
  documents            ShipmentDocument[]
  editRequests         ShipmentEditRequest[]

  @@map("shipments")
}

// فاز ۲۷ — اسناد چندفایلی محموله: هر جایگاه (doc_key) چند فایل با تاریخچهٔ آپلودکننده/زمان
model ShipmentDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  docKey     String   @map("doc_key") @db.VarChar(50)
  fileUrl    String   @map("file_url")
  fileName   String?  @map("file_name") @db.VarChar(300)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  uploader User?    @relation("ShipmentDocumentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([shipmentId, docKey])
  @@map("shipment_documents")
}

// فاز ۲۷ — درخواست اصلاح مرحلهٔ قفل‌شده؛ تأیید/رد از داخل اعلان (اولین استفادهٔ واقعی notifications.actions)
model ShipmentEditRequest {
