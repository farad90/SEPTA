model FinancialProposalPriceChangeRequest {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialProposalItemId  String    @map("financial_proposal_item_id") @db.Uuid
  requestedPrice           Decimal   @map("requested_price") @db.Decimal(18, 4)
