}

model FreightRfqPackage {
  freightRfqId String @map("freight_rfq_id") @db.Uuid
  packageId    String @map("package_id") @db.Uuid

  freightRfq FreightRfq @relation(fields: [freightRfqId], references: [id], onDelete: Cascade)
  package    Package    @relation(fields: [packageId], references: [id])

  @@id([freightRfqId, packageId])
  @@map("freight_rfq_packages")
}

model FreightOffer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freightRfqId    String    @map("freight_rfq_id") @db.Uuid
  price           Decimal   @db.Decimal(18, 4)
  currencyCode    String    @map("currency_code") @db.VarChar(3)
  transitTimeDays Int?      @map("transit_time_days")
  offerDate       DateTime? @map("offer_date") @db.Date
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  validityDate    DateTime? @map("validity_date") @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  freightRfq       FreightRfq @relation(fields: [freightRfqId], references: [id], onDelete: Cascade)
  currency         Currency   @relation(fields: [currencyCode], references: [currencyCode])
  wonShipments     Shipment[] @relation("SelectedFreightOffer")

  @@map("freight_offers")
}

model Shipment {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentNumber             String    @unique @map("shipment_number") @db.VarChar(50)
  commercialExpertId         String    @map("commercial_expert_id") @db.Uuid
