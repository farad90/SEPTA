  decidedAt   DateTime? @map("decided_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  requester User     @relation("ShipmentEditRequestedBy", fields: [requestedBy], references: [id])
  decider   User?    @relation("ShipmentEditDecidedBy", fields: [decidedBy], references: [id])

  @@map("shipment_edit_requests")
}

model ShipmentPackage {
  shipmentId String @map("shipment_id") @db.Uuid
