# Usage: cp apps/api/.env.staging.example apps/api/.env.staging
# and fill in real values. docker-compose.staging.yml feeds this to the api container.
#
# ⚠️ Every secret in this file (JWT secrets, seed admin password) must be
# DIFFERENT from production's. Staging is a lower-security environment by
# design (used for testing, may have relaxed access) — sharing secrets with
# production would mean a staging compromise is also a production compromise.

# DATABASE_URL here doesn't matter much — docker-compose.staging.yml overrides it
# using POSTGRES_PASSWORD from .env.staging.
DATABASE_URL="postgresql://septa:CHANGE_ME@postgres:5432/septa?schema=public"

PORT=3000

# The staging host's address — same "no domain yet" situation as production's
# .env.production.example, see that file's comment for why this matters for
# password-reset email links specifically.
CORS_ORIGIN="http://YOUR_STAGING_HOST"
FRONTEND_URL="http://YOUR_STAGING_HOST"

# JWT — generate with: openssl rand -hex 32 (run it twice, two DIFFERENT values,
# and make sure neither matches production's)
JWT_ACCESS_SECRET="CHANGE_ME_RUN_openssl_rand_-hex_32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="CHANGE_ME_RUN_openssl_rand_-hex_32_AGAIN_DIFFERENT_VALUE"
JWT_REFRESH_TTL="7d"

# Same "no TLS yet" situation as production — see P0-E1-F1-T1 in the backlog.
COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# Staging's own seed admin — do not reuse production's credentials here.
SEED_ADMIN_EMAIL="staging-admin@poulad-tajhiz.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# SMTP — leave empty to use the fallback "copy the text manually" mode; if you
# do configure it, use a separate sending identity from production's so staging
# test emails are visibly distinguishable from real ones.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="staging-rfq@poulad-tajhiz.com"

RFQ_RESPONSE_DUE_DAYS=7
