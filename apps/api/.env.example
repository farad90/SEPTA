# PostgreSQL (باید با docker-compose.yml هم‌خوان باشه)
DATABASE_URL="postgresql://septa:septa_dev_password@localhost:5432/septa?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# Cookie تنظیم‌شده برای Refresh Token
COOKIE_DOMAIN="localhost"

# آدرس فرانت‌اند — برای ساخت لینک بازیابی رمز عبور در ایمیل
FRONTEND_URL="http://localhost:5173"

# Seed — فقط برای محیط dev/local، قبل از استفاده در production حتماً عوض کن
SEED_ADMIN_EMAIL="admin@poulad-tajhiz.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# SMTP برای ارسال واقعی ایمیل RFQ — اختیاری؛ خالی باشه سیستم حالت «کپی دستی متن» می‌شه
# From = آدرس سیستمی؛ Reply-To خودکار = ایمیل کارشناس ارسال‌کننده
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="rfq@poulad-tajhiz.com"

# مهلت پیش‌فرض پاسخ تأمین‌کننده (روز) — Job شبانه بعد از این مدت وضعیت رو «بدون پاسخ» می‌کنه
RFQ_RESPONSE_DUE_DAYS=7
