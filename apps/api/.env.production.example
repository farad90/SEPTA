# استفاده: cp apps/api/.env.production.example apps/api/.env.production
# و مقادیر واقعی رو جایگزین کن. این فایل توسط docker-compose.prod.yml به کانتینر api داده می‌شه.

# DATABASE_URL اینجا مهم نیست — docker-compose.prod.yml خودش با POSTGRES_PASSWORD رو‌کش می‌کنه
DATABASE_URL="postgresql://septa:CHANGE_ME@postgres:5432/septa?schema=public"

# P1-E3-F1-T1 — همین‌طور REDIS_URL؛ docker-compose.prod.yml با REDIS_PASSWORD رو‌کش می‌کنه
REDIS_URL="redis://:CHANGE_ME@redis:6379"

PORT=3000

# P0-E1-F1-T1/T2 -- must match the DOMAIN value used for Caddy's TLS cert
# (see .env.production at the repo root) and MUST be https:// now that
# Caddy terminates TLS in front of everything -- plain http:// here would
# mean CORS rejects the real frontend's requests. FRONTEND_URL also needs
# to be exact: it's used to build the password-reset email link.
CORS_ORIGIN="https://YOUR_DOMAIN_HERE"
FRONTEND_URL="https://YOUR_DOMAIN_HERE"

# JWT — با این تولید کن: openssl rand -hex 32
JWT_ACCESS_SECRET="CHANGE_ME_RUN_openssl_rand_-hex_32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="CHANGE_ME_RUN_openssl_rand_-hex_32_AGAIN_DIFFERENT_VALUE"
JWT_REFRESH_TTL="7d"

# P0-E1-F1-T2 -- COOKIE_SECURE must be "true" now that Caddy terminates TLS
# in front of everything (P0-E1-F1-T1); "false" would have been correct
# ONLY for the old no-domain/plain-HTTP setup, which this project no longer
# uses. A browser will not store or send a Secure cookie over plain HTTP,
# so this must stay in sync with actually having TLS in place -- do not
# flip this back to "false" without also removing Caddy.
# COOKIE_DOMAIN can stay empty (works fine for a single host) or be set to
# your DOMAIN value explicitly -- either is fine.
COOKIE_DOMAIN=""
COOKIE_SECURE="true"

# فقط برای اولین اجرای seed — بعد از ساخت ادمین اول، این دو خط رو از این فایل حذف/عوض کن
SEED_ADMIN_EMAIL="admin@poulad-tajhiz.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# SMTP — اختیاری؛ خالی بمونه سیستم حالت «کپی دستی متن» می‌شه
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="rfq@poulad-tajhiz.com"

RFQ_RESPONSE_DUE_DAYS=7
