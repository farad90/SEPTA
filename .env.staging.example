# Usage on the staging host:
#   cp .env.staging.example .env.staging
#   (put real values into .env.staging — this file is a template only)
#   GHCR_IMAGE_BASE=ghcr.io/<owner>/<repo> IMAGE_TAG=<commit-sha> \
#     docker compose --env-file .env.staging -f docker-compose.staging.yml pull
#   GHCR_IMAGE_BASE=ghcr.io/<owner>/<repo> IMAGE_TAG=<commit-sha> \
#     docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
#
# ⚠️ Use a DIFFERENT password than production's — staging and production must
# never share credentials, even though staging is lower-stakes.

POSTGRES_PASSWORD="a-strong-staging-only-password-here"

# ghcr.io/<owner>/<repo> — matches what .github/workflows/ci.yml pushes to.
GHCR_IMAGE_BASE="ghcr.io/CHANGE_ME_OWNER/CHANGE_ME_REPO"

# Usually left as the commit SHA of whatever's being tested; "latest" tracks
# the most recent successful build on main.
IMAGE_TAG="latest"
